{
  "$schema": "documentation-bc-ccn-field-map",
  "description": "Canonical static field/section keys for the CCN-NNN Change Control Note artefact produced by documentation-bc-ccn-generator. The 'key' values are language-neutral PascalCase identifiers and MUST be kept byte-stable across runs and languages so they can be bound 1:1 to placeholder tokens (e.g. {{Header}}, {{BusinessContext}}, {{ProposedSolution}}) in the CCN Word template used by md-to-docx-converter. This file is the skill-local copy of the canonical CCN keys; the shared cross-skill copy lives at .github/skills/shared/field-map.json — the two MUST stay in sync.",
  "artifactType": "CCN",
  "idPattern": "^CCN-\\d{3}$",
  "filePattern": "CCN-NNN-<kebab-title>.md",
  "outputFolders": {
    "en": "docs/ccn/",
    "default": "docs/<lang>-ccn/"
  },
  "outputJson": {
    "required": true,
    "filePattern": "CCN-NNN-<kebab-title>.json",
    "rule": "Every run of the skill MUST emit this JSON file alongside the markdown. JSON keys come from this map ('ccnMetadataFields[].key' for the §1 Header table and 'sections[].key' for the H2 bodies); JSON values carry the translated content. Downstream consumer: md-to-docx-converter with the CCN Word template."
  },
  "sectionAnchorTemplate": "<!-- section-key: {{key}} -->",
  "sectionAnchor": {
    "pattern": "<!-- section-key: <CanonicalKey> -->",
    "rule": "Each H2 in the CCN markdown MUST be immediately followed by this anchor on its own line so parsers map sections to their canonical key regardless of language, CCN number, or visible heading text.",
    "example": "## Contexto de negocio\n<!-- section-key: BusinessContext -->\n\n..."
  },
  "supportedLocales": ["en", "es", "fr", "de", "it", "pt", "nl"],
  "numberingPolicy": "template",
  "ccnMetadataFields": [
    { "key": "CcnId",                   "label": "CCN ID",              "labelLocales": { "en": "CCN ID",              "es": "ID CCN",                    "fr": "ID CCN",                    "de": "CCN-ID",              "it": "ID CCN",                    "pt": "ID CCN",                    "nl": "CCN-ID" },              "required": true,  "format": "CCN-NNN",                 "translateValue": true },
    { "key": "CcnTitle",               "label": "Title",               "labelLocales": { "en": "Title",               "es": "Titulo",                    "fr": "Titre",                     "de": "Titel",               "it": "Titolo",                    "pt": "Título",                    "nl": "Titel" },               "required": true,  "format": "text",                    "translateValue": true  },
    { "key": "Customer",                "label": "Customer",            "labelLocales": { "en": "Customer",            "es": "Cliente",                   "fr": "Client",                    "de": "Kunde",               "it": "Cliente",                   "pt": "Cliente",                   "nl": "Klant" },               "required": true,  "format": "text",                    "translateValue": true },
    { "key": "DsdTicket",               "label": "DSD ticket",          "labelLocales": { "en": "DSD ticket",          "es": "Ticket DSD",                "fr": "Ticket DSD",                "de": "DSD-Ticket",          "it": "Ticket DSD",                "pt": "Ticket DSD",                "nl": "DSD-ticket" },          "required": false, "format": "text",                    "translateValue": true, "default": "TBD" },
    { "key": "BcEnvironment",               "label": "BC environment",      "labelLocales": { "en": "BC environment",      "es": "Entorno BC",                "fr": "Environnement BC",          "de": "BC-Umgebung",         "it": "Ambiente BC",               "pt": "Ambiente BC",               "nl": "BC-omgeving" },         "required": false, "format": "text",                    "translateValue": true },
    { "key": "BcVersion",               "label": "BC version baseline", "labelLocales": { "en": "BC version baseline", "es": "Version BC",                "fr": "Version BC",                "de": "BC-Version",          "it": "Versione BC",               "pt": "Versão BC",                 "nl": "BC-versie" },           "required": false, "format": "text",                    "translateValue": true },
    { "key": "Extension",               "label": "Extension affected",  "labelLocales": { "en": "Extension affected",  "es": "Extension",                 "fr": "Extension",                 "de": "Extension",           "it": "Estensione",                "pt": "Extensão",                  "nl": "Extension" },           "required": false, "format": "text",                    "translateValue": true },
    { "key": "SourceUserStory", "label": "Source user story",   "labelLocales": { "en": "Source user story",   "es": "Historia de usuario fuente","fr": "Histoire utilisateur source","de": "Quell-User-Story",    "it": "Storia utente sorgente",    "pt": "História de usuário fonte", "nl": "Bron-user-story" },     "required": false, "format": "US-NNN",                  "translateValue": true },
    { "key": "SourceSpec",    "label": "Source spec",         "labelLocales": { "en": "Source spec",         "es": "Especificacion fuente",     "fr": "Spécification source",      "de": "Quellspezifikation",  "it": "Specifica sorgente",        "pt": "Especificação fonte",       "nl": "Bronspecificatie" },    "required": false, "format": "SPEC-NNN",                "translateValue": true },
    { "key": "ArchitectureRef",            "label": "Architecture",        "labelLocales": { "en": "Architecture",        "es": "Arquitectura",              "fr": "Architecture",              "de": "Architektur",         "it": "Architettura",              "pt": "Arquitetura",               "nl": "Architectuur" },        "required": false, "format": "ARCH-NNN",                "translateValue": true },
    { "key": "AnalysisRef",                "label": "Analysis",            "labelLocales": { "en": "Analysis",            "es": "Analisis",                  "fr": "Analyse",                   "de": "Analyse",             "it": "Analisi",                   "pt": "Análise",                   "nl": "Analyse" },             "required": false, "format": "ANALYSIS-NNN",            "translateValue": true },
    { "key": "PreparedBy",            "label": "Prepared by",         "labelLocales": { "en": "Prepared by",         "es": "Elaborado por",             "fr": "Préparé par",               "de": "Erstellt von",        "it": "Preparato da",              "pt": "Elaborado por",             "nl": "Opgesteld door" },      "required": true,  "format": "text",                    "translateValue": true },
    { "key": "Date",                   "label": "Date",                "labelLocales": { "en": "Date",                "es": "Fecha",                     "fr": "Date",                      "de": "Datum",               "it": "Data",                      "pt": "Data",                      "nl": "Datum" },               "required": true,  "format": "DD-MM-YYYY",              "translateValue": true },
    { "key": "Status",                  "label": "Status",              "labelLocales": { "en": "Status",              "es": "Estado",                    "fr": "Statut",                    "de": "Status",              "it": "Stato",                     "pt": "Estado",                    "nl": "Status" },              "required": true,  "format": "text",                    "translateValue": true  },
    { "key": "RecommendationVerdict",           "label": "Recommendation",      "labelLocales": { "en": "Recommendation",      "es": "Recomendacion",             "fr": "Recommandation",            "de": "Empfehlung",          "it": "Raccomandazione",           "pt": "Recomendação",              "nl": "Aanbeveling" },         "required": true,  "format": "GO|CONDITIONAL-GO|NO-GO", "translateValue": true }
  ],
  "frontmatterFields": [
    { "key": "id",             "yamlKey": "id",             "required": true,  "format": "CCN-NNN",                      "translateValue": true },
    { "key": "title",          "yamlKey": "title",          "required": true,  "format": "text",                          "translateValue": true  },
    { "key": "customer",       "yamlKey": "customer",       "required": true,  "format": "text",                          "translateValue": true },
    { "key": "version",        "yamlKey": "version",        "required": true,  "format": "x.y",                           "translateValue": true },
    { "key": "status",         "yamlKey": "status",         "required": true,  "format": "enum",                          "translateValue": true, "enum": ["Pending Approval", "Approved", "Rejected"] },
    { "key": "dsdTicket",      "yamlKey": "dsd_ticket",     "required": false, "format": "text",                          "translateValue": true },
    { "key": "userStory",      "yamlKey": "user_story",     "required": true,  "format": "US-NNN",                        "translateValue": true },
    { "key": "spec",           "yamlKey": "spec",           "required": true,  "format": "SPEC-NNN",                      "translateValue": true },
    { "key": "architecture",   "yamlKey": "architecture",   "required": false, "format": "ARCH-NNN",                      "translateValue": true },
    { "key": "analysis",       "yamlKey": "analysis",       "required": false, "format": "ANALYSIS-NNN",                  "translateValue": true },
    { "key": "preparedBy",     "yamlKey": "prepared_by",    "required": true,  "format": "text",                          "translateValue": true },
    { "key": "date",           "yamlKey": "date",           "required": true,  "format": "DD-MM-YYYY",                    "translateValue": true },
    { "key": "recommendation", "yamlKey": "recommendation", "required": true,  "format": "enum",                          "translateValue": true, "enum": ["GO", "CONDITIONAL-GO", "NO-GO"] }
  ],
  "sections": [
    { "order": 1,  "key": "Header",              "displayHeading": "Header",                "displayHeadingLocales": { "en": "Header",                            "es": "Cabecera",                                  "fr": "En-tête",                                "de": "Kopf",                                "it": "Intestazione",                              "pt": "Cabeçalho",                              "nl": "Header" },                            "description": "Metadata table (CCN ID, Title, Customer, DSD ticket, BC environment, …) — labels canonical English, values plain text.", "contentType": "header-table" },
    { "order": 2,  "key": "BusinessContext",     "displayHeading": "Business context",      "displayHeadingLocales": { "en": "Business context",    "es": "Contexto de negocio","fr": "Contexte métier",       "de": "Geschäftskontext",       "it": "Contesto di business",          "pt": "Contexto de negócio",        "nl": "Bedrijfscontext" },      "description": "Who / What / Why / Objective / Functional scope / AC summary / Out of scope (Phase 1) / Future enhancements.", "contentType": "text+list+table" },
    { "order": 3,  "key": "ProposedSolution",    "displayHeading": "Proposed solution",     "displayHeadingLocales": { "en": "Proposed solution","es": "Solución propuesta","fr": "Solution proposée", "de": "Vorgeschlagene Lösung","it": "Soluzione proposta",         "pt": "Solução proposta",         "nl": "Voorgestelde oplossing" },"description": "Design principles, AL object inventory, number series, API surface, localisation, OQ resolutions, delivery phases.", "contentType": "table+text" },
    { "order": 4,  "key": "Architecture",        "displayHeading": "Architecture solution", "displayHeadingLocales": { "en": "Architecture solution","es": "Solución de arquitectura","fr": "Solution d'architecture","de": "Architekturlösung","it": "Soluzione architetturale","pt": "Solução de arquitetura","nl": "Architectuuroplossing" },"description": "ADR summary, component view (mermaid), cross-cutting concerns, coexistence, constraints.", "contentType": "diagram+table" },
    { "order": 5,  "key": "FeasibilityAnalysis", "displayHeading": "Feasibility analysis",  "displayHeadingLocales": { "en": "Feasibility analysis","es": "Análisis de viabilidad","fr": "Analyse de faisabilité","de": "Machbarkeitsanalyse","it": "Analisi di fattibilità","pt": "Análise de viabilidade","nl": "Haalbaarheidsanalyse" }, "description": "Change summary, SWOT, risk register, OQ status.", "contentType": "swot+risk-table" },
    { "order": 6,  "key": "TimeEstimate",        "displayHeading": "Time estimate",         "displayHeadingLocales": { "en": "Time estimate",                     "es": "Estimación de tiempo",                      "fr": "Estimation du temps",                    "de": "Zeitschätzung",                       "it": "Stima dei tempi",                            "pt": "Estimativa de tempo",                    "nl": "Tijdschatting" },                      "description": "Effort per phase + calendar duration + (optional) cost table. Shaped by interview answers include_hours / include_costs / scenarios.", "contentType": "table" },
    { "order": 7,  "key": "TestingSetup",        "displayHeading": "Testing setup",         "displayHeadingLocales": { "en": "Testing setup (planned)",           "es": "Configuración de pruebas (planificada)",    "fr": "Configuration des tests (planifiée)",    "de": "Test-Setup (geplant)",                "it": "Configurazione dei test (pianificata)",     "pt": "Configuração de testes (planejada)",     "nl": "Testopzet (gepland)" },                "description": "Per-phase test coverage table + exit gate note.", "contentType": "table" },
    { "order": 8,  "key": "TestingSteps",        "displayHeading": "Testing steps",         "displayHeadingLocales": { "en": "Testing steps (acceptance, executed by Customer)","es": "Pasos de prueba (aceptación, ejecutados por el cliente)","fr": "Étapes de test (acceptation, exécutées par le client)","de": "Testschritte (Abnahme, vom Kunden ausgeführt)","it": "Passi di test (accettazione, eseguiti dal cliente)","pt": "Passos de teste (aceitação, executados pelo cliente)","nl": "Teststappen (acceptatie, uitgevoerd door de klant)" }, "description": "Numbered manual acceptance steps derived from US ACs.", "contentType": "ordered-list" },
    { "order": 9,  "key": "Recommendation",      "displayHeading": "Recommendation",        "displayHeadingLocales": { "en": "Recommendation",                    "es": "Recomendación",                             "fr": "Recommandation",                         "de": "Empfehlung",                          "it": "Raccomandazione",                            "pt": "Recomendação",                           "nl": "Aanbeveling" },                        "description": "GO / CONDITIONAL-GO / NO-GO verdict + justification + (optional) pre-conditions + non-blocking advisories.", "contentType": "verdict" },
    { "order": 10, "key": "Approvals",           "displayHeading": "Approvals",            "displayHeadingLocales": { "en": "Approvals",                        "es": "Aprobaciones",                             "fr": "Approbations",                          "de": "Genehmigungen",                      "it": "Approvazioni",                              "pt": "Aprovações",                            "nl": "Goedkeuringen" },                     "description": "3-row sign-off table (Customer PO / Vendor Tech Lead / Vendor PM).", "contentType": "table" }
  ]
}
