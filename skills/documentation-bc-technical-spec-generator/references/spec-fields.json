      "displayHeadingLocales": { "en": "AL Object Inventory", "es": "Inventario de objetos AL", "fr": "Inventaire des objets AL", "de": "AL-Objektinventar", "it": "Inventario degli oggetti AL", "pt": "Inventário de objetos AL", "nl": "AL-objectinventaris" },
