{
  "$schema": "documentation-bc-technical-spec-field-map",
  "description": "Canonical static field/section keys for the SPEC-NNN technical specification artefact produced by documentation-bc-technical-spec-generator. The 'key' values are language-neutral PascalCase identifiers and MUST be kept byte-stable across runs and languages so they can be bound 1:1 to placeholder tokens (e.g. {{AlObjectInventory}}, {{PhaseOverview}}) in any md-to-docx-converter template. Locale-specific labels and headings live under '*Locales' sub-objects.",
  "artifactType": "SPEC",
  "idPattern": "^SPEC-\\d{3}$",
  "filePattern": "SPEC-NNN-<kebab-title>.spec.md",
  "outputFolder": "openspec/specs/",
  "outputJson": {
    "required": true,
    "filePattern": "SPEC-NNN-<kebab-title>.spec.json",
    "rule": "Every run of the skill MUST emit this JSON file alongside the markdown. JSON keys come from this map; JSON values carry the translated content. Downstream consumer: md-to-docx-converter."
  },
  "sectionAnchorTemplate": "<!-- section-key: {{key}} -->",
  "sectionAnchor": {
    "pattern": "<!-- section-key: <CanonicalKey> -->",
    "rule": "Each H2 in the spec markdown MUST be immediately followed by this anchor on its own line so parsers map sections to their canonical key regardless of language or visible heading text.",
    "example": "## 3. Inventario de objetos AL\n<!-- section-key: AlObjectInventory -->\n\n..."
  },
  "supportedLocales": ["en", "es", "fr", "de", "it", "pt", "nl"],
  "numberingPolicy": "template",
  "specMetadataFields": [
    { "key": "SpecId",          "label": "SPEC ID",         "labelLocales": { "en": "SPEC ID",         "es": "ID SPEC",          "fr": "ID SPEC",           "de": "SPEC-ID",          "it": "ID SPEC",          "pt": "ID SPEC",          "nl": "SPEC-ID" },         "required": true,  "format": "SPEC-NNN",   "translateValue": true },
    { "key": "SpecTitle",       "label": "Title",           "labelLocales": { "en": "Title",           "es": "Titulo",           "fr": "Titre",             "de": "Titel",            "it": "Titolo",           "pt": "Título",           "nl": "Titel" },           "required": true,  "format": "text",       "translateValue": true },
    { "key": "Customer",       "label": "Customer",        "labelLocales": { "en": "Customer",        "es": "Cliente",          "fr": "Client",            "de": "Kunde",            "it": "Cliente",          "pt": "Cliente",          "nl": "Klant" },           "required": true,  "format": "text",       "translateValue": true },
    { "key": "SpecStatus",      "label": "Status",          "labelLocales": { "en": "Status",          "es": "Estado",           "fr": "Statut",            "de": "Status",           "it": "Stato",            "pt": "Estado",           "nl": "Status" },          "required": true,  "format": "enum",       "translateValue": true },
    { "key": "SpecType",        "label": "Type",            "labelLocales": { "en": "Type",            "es": "Tipo",             "fr": "Type",              "de": "Typ",              "it": "Tipo",             "pt": "Tipo",             "nl": "Type" },            "required": true,  "format": "enum",       "translateValue": true },
    { "key": "SourceUserStory", "label": "Source user story","labelLocales": { "en": "Source user story","es": "Historia de usuario fuente","fr": "Histoire utilisateur source","de": "Quell-User-Story","it": "Storia utente sorgente","pt": "História de usuário fonte","nl": "Bron-user-story" },"required": true,  "format": "US-NNN",     "translateValue": true },
    { "key": "Priority",        "label": "Priority",        "labelLocales": { "en": "Priority",        "es": "Prioridad",        "fr": "Priorité",          "de": "Priorität",        "it": "Priorità",         "pt": "Prioridade",       "nl": "Prioriteit" },      "required": true,  "format": "enum",       "translateValue": true },
    { "key": "Complexity",      "label": "Complexity",      "labelLocales": { "en": "Complexity",      "es": "Complejidad",      "fr": "Complexité",        "de": "Komplexität",      "it": "Complessità",      "pt": "Complexidade",     "nl": "Complexiteit" },    "required": true,  "format": "enum",       "translateValue": true },
    { "key": "EstimatedEffort", "label": "Estimated effort","labelLocales": { "en": "Estimated effort","es": "Esfuerzo estimado", "fr": "Effort estimé",     "de": "Geschätzter Aufwand","it": "Sforzo stimato", "pt": "Esforço estimado", "nl": "Geschatte inspanning" },"required": true,"format": "text",       "translateValue": true },
    { "key": "SpecModule",      "label": "Module",          "labelLocales": { "en": "Module",          "es": "Módulo",           "fr": "Module",            "de": "Modul",            "it": "Modulo",           "pt": "Módulo",           "nl": "Module" },          "required": true,  "format": "text",       "translateValue": true },
    { "key": "Prefix",          "label": "Prefix",          "labelLocales": { "en": "Prefix",          "es": "Prefijo",          "fr": "Préfixe",           "de": "Präfix",           "it": "Prefisso",         "pt": "Prefixo",          "nl": "Voorvoegsel" },     "required": true,  "format": "text",       "translateValue": true },
    { "key": "IdRange",         "label": "ID range",        "labelLocales": { "en": "ID range",        "es": "Rango de IDs",     "fr": "Plage d'identifiants","de": "ID-Bereich",     "it": "Intervallo ID",    "pt": "Intervalo de IDs", "nl": "ID-bereik" },       "required": true,  "format": "from-to",    "translateValue": true },
    { "key": "CreatedDate",     "label": "Created date",    "labelLocales": { "en": "Created date",    "es": "Fecha creación",   "fr": "Date de création",  "de": "Erstelldatum",     "it": "Data creazione",   "pt": "Data criação",     "nl": "Aanmaakdatum" },    "required": true,  "format": "DD-MM-YYYY", "translateValue": true },
    { "key": "PreparedBy",      "label": "Prepared by",     "labelLocales": { "en": "Prepared by",     "es": "Elaborado por",     "fr": "Préparé par",       "de": "Erstellt von",      "it": "Preparato da",      "pt": "Elaborado por",     "nl": "Opgesteld door" },    "required": true,  "format": "text",       "translateValue": true },
    { "key": "ApprovedDate",    "label": "Approved date",   "labelLocales": { "en": "Approved date",   "es": "Fecha aprobación", "fr": "Date d'approbation","de": "Genehmigungsdatum","it": "Data approvazione","pt": "Data aprovação",    "nl": "Goedkeuringsdatum" },"required": false,"format": "DD-MM-YYYY", "translateValue": true }
  ],
  "frontmatterFields": [
    { "key": "id",              "yamlKey": "id",               "required": true,  "format": "SPEC-NNN",   "translateValue": true },
    { "key": "title",           "yamlKey": "title",            "required": true,  "format": "text",       "translateValue": true  },
    { "key": "customer",        "yamlKey": "customer",         "required": true,  "format": "text",       "translateValue": true },
    { "key": "version",         "yamlKey": "version",          "required": true,  "format": "x.y.z",      "translateValue": true },
    { "key": "type",            "yamlKey": "type",             "required": true,  "format": "enum",       "translateValue": true, "enum": ["features", "bugfix", "infrastructure", "migration"] },
    { "key": "status",          "yamlKey": "status",           "required": true,  "format": "enum",       "translateValue": true, "enum": ["draft", "approved", "in-progress", "completed", "rejected"] },
    { "key": "userStory",       "yamlKey": "user_story",       "required": true,  "format": "US-NNN",     "translateValue": true },
    { "key": "priority",        "yamlKey": "priority",         "required": true,  "format": "enum",       "translateValue": true, "enum": ["High", "Medium", "Low"] },
    { "key": "complexity",      "yamlKey": "complexity",       "required": true,  "format": "enum",       "translateValue": true, "enum": ["Low", "Medium", "Medium-High", "High"] },
    { "key": "estimatedEffort", "yamlKey": "estimated_effort", "required": true,  "format": "text",       "translateValue": true },
    { "key": "module",          "yamlKey": "module",           "required": true,  "format": "text",       "translateValue": true  },
    { "key": "prefix",          "yamlKey": "prefix",           "required": true,  "format": "text",       "translateValue": true },
    { "key": "idRange",         "yamlKey": "id_range",         "required": true,  "format": "from-to",    "translateValue": true },
    { "key": "preparedBy",      "yamlKey": "prepared_by",      "required": true,  "format": "text",       "translateValue": true },
    { "key": "createdDate",     "yamlKey": "created_date",     "required": true,  "format": "DD-MM-YYYY", "translateValue": true },
    { "key": "approvedDate",    "yamlKey": "approved_date",    "required": false, "format": "DD-MM-YYYY", "translateValue": true }
  ],
  "sections": [
    {
      "order": 1,
      "key": "UserStoryReference",
      "displayHeading": "User Story Reference",
      "displayHeadingLocales": { "en": "User Story Reference", "es": "Referencia a la historia de usuario", "fr": "Référence à l'histoire utilisateur", "de": "Referenz auf User Story", "it": "Riferimento alla storia utente", "pt": "Referência à história de usuário", "nl": "Verwijzing naar user story" },
      "description": "Source US, Product Owner, status, and the As-a / I-want / so-that quote.",
      "contentType": "text"
    },
    {
      "order": 2,
      "key": "TechnicalDesignOverview",
      "displayHeading": "Technical Design Overview",
      "displayHeadingLocales": { "en": "Technical Design Overview", "es": "Visión técnica del diseño", "fr": "Vue d'ensemble de la conception technique", "de": "Technische Designübersicht", "it": "Panoramica del design tecnico", "pt": "Visão geral do design técnico", "nl": "Technisch ontwerpoverzicht" },
