{
  "$schema": "documentation-bc-architecture-field-map",
  "description": "Canonical static field/section keys for the ARCH-NNN architecture artefact produced by documentation-bc-architecture-generator. The 'key' values are language-neutral PascalCase identifiers and MUST be kept byte-stable across runs and languages so they can be bound 1:1 to placeholder tokens (e.g. {{Context}}, {{LogicalComponentView}}, {{CrossCuttingConcerns}}) in any md-to-docx-converter template. Locale-specific labels and headings live under '*Locales' sub-objects.",
  "artifactType": "ARCHITECTURE",
  "idPattern": "^ARCH-\\d{3}$",
  "filePattern": "ARCH-NNN-<kebab-title>.architecture.md",
  "outputFolder": "openspec/architecture/",
  "outputJson": {
    "required": true,
    "filePattern": "ARCH-NNN-<kebab-title>.architecture.json",
    "rule": "Every run of the skill MUST emit this JSON file alongside the markdown. JSON keys come from this map; JSON values carry the translated content. Downstream consumer: md-to-docx-converter."
  },
  "sectionAnchorTemplate": "<!-- section-key: {{key}} -->",
  "sectionAnchor": {
    "pattern": "<!-- section-key: <CanonicalKey> -->",
    "rule": "Each H2 in the architecture markdown MUST be immediately followed by this anchor on its own line so parsers map sections to their canonical key regardless of language or visible heading text.",
    "example": "## 4. Vista lógica de componentes\n<!-- section-key: LogicalComponentView -->\n\n..."
  },
  "supportedLocales": ["en", "es", "fr", "de", "it", "pt", "nl"],
  "numberingPolicy": "template",
  "archMetadataFields": [
    { "key": "ArchId",          "label": "ARCH ID",         "labelLocales": { "en": "ARCH ID",         "es": "ID ARCH",           "fr": "ID ARCH",           "de": "ARCH-ID",           "it": "ID ARCH",           "pt": "ID ARCH",           "nl": "ARCH-ID" },           "required": true,  "format": "ARCH-NNN",   "translateValue": true },
    { "key": "ArchTitle",       "label": "Title",           "labelLocales": { "en": "Title",           "es": "Titulo",            "fr": "Titre",             "de": "Titel",             "it": "Titolo",            "pt": "Título",            "nl": "Titel" },             "required": true,  "format": "text",       "translateValue": true },
    { "key": "Customer",       "label": "Customer",        "labelLocales": { "en": "Customer",        "es": "Cliente",           "fr": "Client",            "de": "Kunde",             "it": "Cliente",           "pt": "Cliente",           "nl": "Klant" },             "required": true,  "format": "text",       "translateValue": true },
    { "key": "SourceSpec",      "label": "Source spec",     "labelLocales": { "en": "Source spec",     "es": "Especificación fuente","fr": "Spécification source","de": "Quellspezifikation","it": "Specifica sorgente","pt": "Especificação fonte","nl": "Bronspecificatie" },"required": true,  "format": "SPEC-NNN",   "translateValue": true },
    { "key": "SourceUserStory", "label": "Source user story","labelLocales": { "en": "Source user story","es": "Historia de usuario fuente","fr": "Histoire utilisateur source","de": "Quell-User-Story","it": "Storia utente sorgente","pt": "História de usuário fonte","nl": "Bron-user-story" },"required": true,"format": "US-NNN",     "translateValue": true },
    { "key": "SourceCcn",       "label": "Source CCN",      "labelLocales": { "en": "Source CCN",      "es": "CCN fuente",        "fr": "CCN source",        "de": "Quell-CCN",         "it": "CCN sorgente",      "pt": "CCN fonte",         "nl": "Bron-CCN" },          "required": false, "format": "CCN-NNN",    "translateValue": true },
    { "key": "ArchStatus",      "label": "Status",          "labelLocales": { "en": "Status",          "es": "Estado",            "fr": "Statut",            "de": "Status",            "it": "Stato",             "pt": "Estado",            "nl": "Status" },            "required": true,  "format": "enum",       "translateValue": true },
    { "key": "ArchVersion",     "label": "Version",         "labelLocales": { "en": "Version",         "es": "Versión",           "fr": "Version",           "de": "Version",           "it": "Versione",          "pt": "Versão",            "nl": "Versie" },            "required": true,  "format": "semver",     "translateValue": true },
    { "key": "CreatedDate",     "label": "Created date",    "labelLocales": { "en": "Created date",    "es": "Fecha creación",    "fr": "Date de création",  "de": "Erstelldatum",      "it": "Data creazione",    "pt": "Data criação",      "nl": "Aanmaakdatum" },      "required": true,  "format": "DD-MM-YYYY", "translateValue": true },
    { "key": "Author",          "label": "Author",          "labelLocales": { "en": "Author",          "es": "Autor",             "fr": "Auteur",            "de": "Autor",             "it": "Autore",            "pt": "Autor",             "nl": "Auteur" },            "required": true,  "format": "text",       "translateValue": true },
    { "key": "PreparedBy",      "label": "Prepared by",     "labelLocales": { "en": "Prepared by",     "es": "Elaborado por",     "fr": "Préparé par",       "de": "Erstellt von",      "it": "Preparato da",      "pt": "Elaborado por",     "nl": "Opgesteld door" },    "required": true,  "format": "text",       "translateValue": true }
  ],
  "frontmatterFields": [
    { "key": "id",          "yamlKey": "id",           "required": true,  "format": "ARCH-NNN",   "translateValue": true },
    { "key": "title",       "yamlKey": "title",        "required": true,  "format": "text",       "translateValue": true  },
    { "key": "customer",   "yamlKey": "customer",     "required": true,  "format": "text",       "translateValue": true },
    { "key": "spec",        "yamlKey": "spec",         "required": true,  "format": "SPEC-NNN",   "translateValue": true },
    { "key": "userStory",   "yamlKey": "user_story",   "required": true,  "format": "US-NNN",     "translateValue": true },
    { "key": "ccn",         "yamlKey": "ccn",          "required": false, "format": "CCN-NNN",    "translateValue": true },
    { "key": "status",      "yamlKey": "status",       "required": true,  "format": "enum",       "translateValue": true, "enum": ["draft", "approved", "superseded"] },
    { "key": "version",     "yamlKey": "version",      "required": true,  "format": "x.y",        "translateValue": true },
    { "key": "createdDate", "yamlKey": "created_date", "required": true,  "format": "DD-MM-YYYY", "translateValue": true },
    { "key": "author",      "yamlKey": "author",       "required": true,  "format": "text",       "translateValue": true },
    { "key": "preparedBy",  "yamlKey": "prepared_by",  "required": true,  "format": "text",       "translateValue": true }
  ],
  "sections": [
    {
      "order": 1,
      "key": "Context",
      "displayHeading": "Context",
      "displayHeadingLocales": { "en": "Context", "es": "Contexto", "fr": "Contexte", "de": "Kontext", "it": "Contesto", "pt": "Contexto", "nl": "Context" },
      "description": "Business context, technical context, and explicit scope (in / out).",
      "contentType": "text+list"
    },
    {
      "order": 2,
      "key": "ArchitecturalDrivers",
      "displayHeading": "Architectural drivers",
      "displayHeadingLocales": { "en": "Architectural drivers", "es": "Drivers arquitectónicos", "fr": "Drivers architecturaux", "de": "Architekturtreiber", "it": "Driver architetturali", "pt": "Drivers arquiteturais", "nl": "Architectuurdrivers" },
      "description": "Numbered D-N driver table linking back to US-AC / SPEC / CCN sources with implications.",
      "contentType": "table"
    },
    {
      "order": 3,
      "key": "ArchitecturalStyleAndDecisions",
      "displayHeading": "Architectural style and key decisions",
      "displayHeadingLocales": { "en": "Architectural style and key decisions", "es": "Estilo arquitectónico y decisiones clave", "fr": "Style architectural et décisions clés", "de": "Architekturstil und Kernentscheidungen", "it": "Stile architetturale e decisioni chiave", "pt": "Estilo arquitetural e decisões-chave", "nl": "Architectuurstijl en kernbeslissingen" },
      "description": "Chosen style + numbered ADR-N records (Context / Decision / Consequence / Alternatives rejected).",
      "contentType": "adr-list"
    },
    {
      "order": 4,
      "key": "LogicalComponentView",
      "displayHeading": "Logical component view",
      "displayHeadingLocales": { "en": "Logical component view", "es": "Vista lógica de componentes", "fr": "Vue logique des composants", "de": "Logische Komponentensicht", "it": "Vista logica dei componenti", "pt": "Visão lógica de componentes", "nl": "Logisch componentbeeld" },
      "description": "ASCII / mermaid component diagram + responsibility table.",
      "contentType": "diagram+table"
    },
    {
      "order": 5,
      "key": "KeyRuntimeFlows",
      "displayHeading": "Key runtime flows",
      "displayHeadingLocales": { "en": "Key runtime flows", "es": "Flujos clave en tiempo de ejecución", "fr": "Flux d'exécution clés", "de": "Wichtige Laufzeitabläufe", "it": "Flussi runtime principali", "pt": "Fluxos de execução principais", "nl": "Belangrijke runtime-flows" },
      "description": "Happy path + optimised / cached + configuration + error/no-match ASCII flows or mermaid sequence diagrams.",
      "contentType": "diagram"
    },
    {
      "order": 6,
      "key": "DataArchitecture",
      "displayHeading": "Data architecture",
      "displayHeadingLocales": { "en": "Data architecture", "es": "Arquitectura de datos", "fr": "Architecture des données", "de": "Datenarchitektur", "it": "Architettura dei dati", "pt": "Arquitetura de dados", "nl": "Data-architectuur" },
      "description": "Entity-relationship overview + storage/ownership/lifecycle table + key-derivation notes.",
      "contentType": "diagram+table"
    },
    {
      "order": 7,
      "key": "CrossCuttingConcerns",
      "displayHeading": "Cross-cutting concerns",
      "displayHeadingLocales": { "en": "Cross-cutting concerns", "es": "Aspectos transversales", "fr": "Préoccupations transversales", "de": "Querschnittsthemen", "it": "Aspetti trasversali", "pt": "Aspectos transversais", "nl": "Cross-cutting concerns" },
      "description": "Security, reliability, performance, observability, localisation, RapidStart/portability, upgrade/migration.",
      "contentType": "text+list"
    },
    {
      "order": 8,
      "key": "CoexistenceWithLegacy",
      "displayHeading": "Coexistence with legacy",
      "displayHeadingLocales": { "en": "Coexistence with legacy", "es": "Coexistencia con código heredado", "fr": "Coexistence avec le code hérité", "de": "Koexistenz mit Legacy-Code", "it": "Coesistenza con codice legacy", "pt": "Coexistência com código legado", "nl": "Coëxistentie met legacy-code" },
      "description": "Which legacy objects remain untouched and which (if any) are modified, citing the enforcing ADRs.",
      "contentType": "text"
    },
    {
      "order": 9,
      "key": "ConstraintsAndLimitations",
      "displayHeading": "Constraints and known limitations",
      "displayHeadingLocales": { "en": "Constraints and known limitations", "es": "Restricciones y limitaciones conocidas", "fr": "Contraintes et limitations connues", "de": "Einschränkungen und bekannte Grenzen", "it": "Vincoli e limitazioni note", "pt": "Restrições e limitações conhecidas", "nl": "Beperkingen en bekende limitaties" },
      "description": "Numbered C-N limitation table with source ADR/D-N and mitigation.",
      "contentType": "table"
    }
  ]
}
